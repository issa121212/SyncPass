# Copiar a .env. Configuracion LOCAL sin claves AWS ni contrasenas de usuarios.
# El perfil local usa H2 en memoria: sus datos se pierden al detenerlo.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
AWS_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=us-east-1_qf9qh3X5q
AWS_COGNITO_CLIENT_ID=3jgb0o4be28sb0cnqmjqihrfq4
# Allowlist para la API compartida por Android y web; no reemplaza el cliente Android.
AWS_COGNITO_ALLOWED_CLIENT_IDS=3jgb0o4be28sb0cnqmjqihrfq4,4pp1hrlitnamn0pl2es7e8ejmn
CORS_ALLOWED_ORIGINS=http://localhost:5173
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_qf9qh3X5q
# Identificadores publicos; no usar client secret en Android.
# Para PostgreSQL/produccion, definir fuera del repositorio:
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=jdbc:postgresql://<host>:5432/<database>
# DATABASE_USER=<usuario>
# DATABASE_PASSWORD=<secreto>
# CORS_ALLOWED_ORIGINS=https://<web-autorizada>
# En EC2 utilizar rol IAM, sin access keys estaticas.

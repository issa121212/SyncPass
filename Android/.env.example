# Identificadores PUBLICOS del entorno Cognito existente, no credenciales secretas.
# Copiar a .env (PREPARAR_RUN.ps1 lo hace). Nunca subir .env.
# 127.0.0.1 funciona en celular USB y emulador con SyncPass Local en Android Studio.
# Sin adb reverse, el emulador usa http://10.0.2.2:8080/.
API_BASE_URL=http://127.0.0.1:8080/
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_qf9qh3X5q
COGNITO_CLIENT_ID=3jgb0o4be28sb0cnqmjqihrfq4
COGNITO_REDIRECT_URI=com.rojas.syncpass://cognito/callback
COGNITO_LOGOUT_URI=com.rojas.syncpass://cognito/callback
COGNITO_SCOPES=openid
# Release: cambiar API_BASE_URL por el endpoint HTTPS publico y recompilar.
